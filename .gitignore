# ==============================================
# BlueMoon Building Management System - .gitignore
# ==============================================

# 1. Dependencies (Vercel & Render will run npm install automatically)
node_modules/
*/node_modules/
frontend/node_modules/
backend/node_modules/

# 2. Environment Variables & Secret Credentials (DO NOT COMMIT)
.env
.env.local
.env.*.local
.env.development
.env.production
frontend/.env.local
frontend/.env
backend/.env.local
backend/.env
serviceAccountKey.json
*serviceAccount*.json
*firebase-adminsdk*.json
backend/serviceAccountKey.json
*.pem
*.key

# 3. Next.js Build Outputs & Cache
.next/
frontend/.next/
out/
frontend/out/
build/
dist/
.turbo/
.vercel/

# 4. Logs & Debug files
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 5. OS & IDE System Files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
